# ====================================================================
# 1. 操作系统相关 (Operating System Files)
# ====================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Linux
.fuse_hidden
*.swp
*~
.nfs*

# ====================================================================
# 2. 编辑器与 IDE (IDEs & Editors)
# ====================================================================
# VS Code / Cursor
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/snippets/
*.code-workspace
.history/
.cursor/

# JetBrains (IntelliJ, WebStorm, PyCharm, etc.)
# 建议忽略整个 .idea，除非你想共享项目运行配置
.idea/
*.iws
*.iml
*.ipr
out/
cmake-build-*/

# Sublime Text
*.sublime-project
*.sublime-workspace

# ====================================================================
# 3. 编程语言与依赖 (Languages & Dependencies)
# ====================================================================
# Node.js (不加前缀斜杠以支持单仓库/多包架构)
node_modules/
jspm_packages/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Java / Maven / Gradle
target/
build/
.gradle/
bin/
!**/src/main/resources/bin/
# 排除 Maven Wrapper 但保留 jar (如果项目需要)
!.mvn/wrapper/maven-wrapper.jar

# Compiled C/C++ / Rust
*.o
*.obj
*.out
*.exe
*.so
*.dll
*.a
*.lib
target/

# ====================================================================
# 4. 环境配置与敏感信息 (Environment & Secrets)
# ====================================================================
# 核心原则：严禁上传包含密钥的文件
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*.crt

# ====================================================================
# 5. 日志、临时文件与构建产物 (Logs, Temp & Build)
# ====================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# 临时文件夹与缓存
tmp/
temp/
.cache/
.sass-cache/
.eslintcache
.parcel-cache
.next/
.nuxt/

# 单元测试覆盖率报告
coverage/
*.lcov
htmlcov/

# ====================================================================
# 6. 数据库与大文件 (Databases & Large Files)
# ====================================================================
*.sqlite
*.db
*.sql
*.dump
*.tar
*.zip
*.gz
*.7z

# ====================================================================
# 7. 自定义忽略 (Local Overrides)
# ====================================================================
# 如果有个人专属的本地排除规则，可以写在这里
**/testfile.txt
**/in.txt
**/out.txt
**/error.txt
**/lexer.txt
**/parser.txt
**/temp.txt
**/log.txt